# =============================================================================
# Excel Reporter — Environment Variables
# Copy this file to .env and fill in the real values.
# The .env file is gitignored and should NEVER be committed.
# =============================================================================

# === Main Database (Data Warehouse — PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dwh_db
DB_USER=reporter_user
DB_PASSWORD=CHANGEME

# === BD Agent (LLM via WhatsApp) ===

# Read-only Postgres user for the WhatsApp BD Agent.
# Run scripts/sql/agent_user.sql first (substitute CHANGEME with real password).
# Format: postgresql://agent_user:<password>@<host>:<port>/<dbname>
AGENT_DB_URL=postgresql://agent_user:CHANGEME@localhost:5432/dwh_db

# Google Gemini API key -- used by the BD Agent to call gemini-2.0-flash-lite.
# Get yours free at https://aistudio.google.com/app/apikey (free tier available).
# To disable the BD Agent entirely without code changes, set this to empty string.
GEMINI_API_KEY=

# (Optional) Groq API key -- reserved for a future fallback LLM provider.
# Leave empty if you are only using Gemini.
# GROQ_API_KEY=

# Base URL of the Baileys WhatsApp service (Node.js).
# Default port 3001 when running manually; use 3000 if running via docker-compose.
WHATSAPP_SERVICE_URL=http://localhost:3001

# Base URL of this FastAPI app -- used by the Node WhatsApp service to forward
# inbound messages to the BD Agent endpoint (POST /agent/message).
PYTHON_AGENT_URL=http://localhost:8000/agent/message
# === BD Agent Sandbox (optional) ===
# Set SANDBOX_ENABLED=true to allow the agent to generate Python reports
# in a hardened Docker container. Requires the sandbox image to be built first:
#   bash scripts/build_sandbox_image.sh
SANDBOX_ENABLED=false

# Maximum wall-clock seconds before the sandbox container is killed.
SANDBOX_TIMEOUT_SECONDS=30

# Docker image tag used for the sandbox. Change only if you retag the image.
SANDBOX_IMAGE_TAG=bd-agent-sandbox:latest

# === Admin panel (optional) ===
# Root of the data/output/ tree the Archivos screen reads. Leave unset to use
# this checkout's own data/output/. Point it elsewhere to browse another
# checkout's artifacts (e.g. production, from a worktree) — read-only: the
# panel's artifact routes expose no write or delete method.
# ADMIN_PANEL_ARTIFACTS_ROOT=/path/to/Informes Badie/data/output
