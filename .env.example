# =============================================================================
# Excel Reporter — Environment Variables
# Copy this file to .env and fill in the real values.
# The .env file is gitignored and should NEVER be committed.
# =============================================================================

# === Main Database (Data Warehouse — PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dwh_db
DB_USER=reporter_user
DB_PASSWORD=CHANGEME

# === BD Agent (LLM via WhatsApp) ===

# Read-only Postgres user for the WhatsApp BD Agent.
# Run scripts/sql/agent_user.sql first (substitute CHANGEME with real password).
# Format: postgresql://agent_user:<password>@<host>:<port>/<dbname>
AGENT_DB_URL=postgresql://agent_user:CHANGEME@localhost:5432/dwh_db

# Google Gemini API key -- used by the BD Agent to call gemini-2.0-flash-lite.
# Get yours free at https://aistudio.google.com/app/apikey (free tier available).
# To disable the BD Agent entirely without code changes, set this to empty string.
GEMINI_API_KEY=

# (Optional) Groq API key -- reserved for a future fallback LLM provider.
# Leave empty if you are only using Gemini.
# GROQ_API_KEY=

# Base URL of the Baileys WhatsApp service (Node.js).
# Default port 3000 when running via docker-compose; use 3001 if running manually.
WHATSAPP_SERVICE_URL=http://localhost:3000

# Base URL of this FastAPI app -- used by the Node WhatsApp service to forward
# inbound messages to the BD Agent endpoint (POST /agent/message).
PYTHON_AGENT_URL=http://localhost:8000
