# Everything under data/ is generated output (reports, captures, send logs) —
# never committed. Blanket-ignore the dir; the specific rules below are kept
# for documentation and stay valid.
data/

# NO Excel files, images, PDFs anywhere under data/ (templates, outputs,
# captures — all live locally, never committed)
data/**/*.xlsx
data/**/*.xlsm
data/**/*.xlsb
data/**/*.xls
data/**/*.pptx
data/**/*.pdf
data/**/*.png
data/**/*.jpg
data/**/*.jpeg
data/**/*.gif
data/**/*.webp

# Management UI runtime data (not committed)
data/mgmt.db
data/runs/

# Sensitive configs (contain PII — emails, phone numbers, etc.)
configs/contactos.json
configs/contactos_agente.json

# WhatsApp service runtime state
whatsapp-service/node_modules/
whatsapp-service/session/
whatsapp-service/session.*/

# Engram local memory database
.engram/

# Local tool config
.gga

# Temp configs left behind by ad-hoc runs
configs/tmp*.json

# Root-level local debug scripts (not part of the codebase)
/test.xlsx
/test_*.py
/test_*.md
/get_cols.py
/reporte_cobertura_marca.py

# Root-level ad-hoc report output (commercial data: sales, stock, client lists).
# These land here when a report is run without an output path. `git add -A` must
# never sweep them into the history. Versioned inputs are whitelisted below.
/*.xlsx
/*.png
/*.bak.xlsx
!/factor_conversion_quesos.xlsx

# CodeGraph index — regenerable, ~30 MB
.codegraph/

# dashboards/ — build output. dashboard.html comes out of build_dashboard.py and
# the dated zips out of package.sh; the sources next to them are versioned.
dashboards/**/dashboard.html
dashboards/**/*.zip

# Logs
*.log
bd_agent/errors.log
bd_agent/errors.log.*

# OS
.DS_Store
Thumbs.db

# resumen-web (standalone React app) — build artifacts
resumen-web/node_modules/
resumen-web/dist/
# Skill registry cache (regenerable)
.atl/.skill-registry.cache.json
